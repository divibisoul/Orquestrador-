  "runtime_policy": {
    "native_owner_first": true,
    "external_provider_is_optional_augmenter": true,
    "execution_requires_explicit_adapter": true,
    "missing_adapter_state": "BLOCKED",
    "no_fake_runtime_success": true,
    "preserve_history": true,
    "direct_affinity_semantics": "targets in external-capabilities.json are direct adapter hosts; consumers are Mesh users and do not imply provider ownership"
  },
