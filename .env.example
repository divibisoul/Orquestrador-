# N07 application authentication
N07_APP_TOKEN=change-me
N07_CORS_ORIGINS=https://your-frontend.example
N07_HTTP_ADDR=:8080
N07_MAX_REQUEST_BYTES=2097152
N07_MAX_UPLOAD_BYTES=104857600
N07_BACKEND_TIMEOUT=30s

# Soul Mesh
SOUL_MESH_HMAC_SECRET=change-me
SOUL_MESH_SECRET=
N07_MESH_ALLOW_UNAUTH_LOCAL=false
N07_MESH_REGISTRY_URL=

# Supabase server-side persistence (service_role must never be exposed to browsers)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_RUNS_TABLE=n07_runs
SUPABASE_ARTIFACTS_TABLE=n07_artifacts

# Storage provider selection: auto prefers current Storacha when configured, otherwise legacy compatibility.
STORACHA_MODE=auto
STORACHA_GUPPY_BIN=guppy
STORACHA_SPACE=did:key:YOUR_SPACE_DID
STORACHA_DATA_DIR=/var/lib/n07/storacha
STORACHA_GATEWAY_URL=https://storacha.link/ipfs
STORACHA_SERVICE_URL=
STORACHA_SERVICE_DID=
STORACHA_RECEIPTS_URL=
STORACHA_INDEXING_SERVICE_URL=
STORACHA_INDEXING_SERVICE_DID=

# Legacy Web3.Storage-compatible API retained for compatibility with existing deployments.
# It is not selected in auto mode when Storacha is fully configured.
WEB3_STORAGE_API_URL=https://api.web3.storage
WEB3_STORAGE_TOKEN=change-me
N07_IPFS_GATEWAY_URL=https://dweb.link/ipfs

# Jev decision service (server-side only)
JEV_API_KEY=
JEV_API_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_MAX_RETRIES=2
JEV_RETRY_BACKOFF=1s

# Federated peer endpoints used by N07 discovery/delegation
SOUL_MESH_N01_URL=
SOUL_MESH_N02_URL=
SOUL_MESH_N03_URL=
SOUL_MESH_N04_URL=
SOUL_MESH_N05_URL=
SOUL_MESH_N06_URL=

# OpenAI-compatible ingress for Open WebUI and other clients
N07_OPENAI_COMPAT_ENABLED=true
N07_OPENAI_CAPABILITY=ai.generate

# N07 Agent Arsenal sidecar (Superpowers + ECC + pinned Ruflo)
SOUL_AGENT_ARSENAL_URL=
SOUL_AGENT_ARSENAL_TOKEN=
SOUL_AGENT_ARSENAL_TIMEOUT=25

# Agent Arsenal gateway
AGENT_ARSENAL_HOST=0.0.0.0
AGENT_ARSENAL_PORT=8090
AGENT_ARSENAL_ROOT=/var/lib/soul-agent-arsenal
AGENT_ARSENAL_TOKEN=
AGENT_ARSENAL_EXECUTE=false
AGENT_ARSENAL_COMMAND_TIMEOUT_MS=20000
AGENT_ARSENAL_INSTALL_TIMEOUT_MS=300000

# Executable external provider runtime adapters
# vLLM / SGLang expose their native OpenAI-compatible /v1 interface.
SOUL_VLLM_URL=
SOUL_VLLM_TOKEN=
SOUL_VLLM_MODEL=
SOUL_SGLANG_URL=
SOUL_SGLANG_TOKEN=
SOUL_SGLANG_MODEL=
# SwarmClaw A2A JSON-RPC endpoint
SOUL_SWARMCLAW_URL=
SOUL_SWARMCLAW_TOKEN=
SOUL_SWARMCLAW_AGENT_ID=
# Langfuse public health endpoint (status probe; trace emission remains through existing observability boundary)
SOUL_LANGFUSE_URL=
SOUL_LANGFUSE_TOKEN=
