{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/contracts/soul-mesh/hop-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "correlationId",
    "source",
    "target",
    "capability",
    "status",
    "evidenceState"
  ],
  "properties": {
    "messageId": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "error",
        "degraded",
        "cancelled"
      ]
    },
    "result": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "evidenceState": {
      "enum": [
        "REAL",
        "PROJECTED",
        "BLOCKED",
        "UNMEASURABLE"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    }
  }
}