{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/contracts/soul-mesh/capability-registration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "status",
    "inputSchemaRef",
    "outputSchemaRef",
    "transport",
    "evidenceState",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner": {
      "enum": [
        "N01",
        "N02",
        "N03",
        "N04",
        "N05",
        "N06",
        "N07",
        "SARA"
      ]
    },
    "status": {
      "enum": [
        "DECLARED",
        "CONFIGURED",
        "AVAILABLE",
        "EXECUTABLE",
        "DEGRADED",
        "BLOCKED"
      ]
    },
    "inputSchemaRef": {
      "type": "string",
      "minLength": 1
    },
    "outputSchemaRef": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "type": "object",
      "required": [
        "protocol",
        "endpoint"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "soul-mesh/1"
        },
        "endpoint": {
          "type": "string"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "maxPayloadBytes": {
          "type": "integer",
          "maximum": 2097152
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceState": {
      "enum": [
        "REAL",
        "PROJECTED",
        "BLOCKED",
        "UNMEASURABLE"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "repository",
        "revision"
      ],
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "minLength": 7
        }
      }
    }
  }
}