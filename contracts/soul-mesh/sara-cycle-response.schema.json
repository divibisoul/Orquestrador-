{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/contracts/soul-mesh/sara-cycle-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cycle_id",
    "final_state",
    "converged",
    "rollback_performed",
    "execution_report",
    "trace_hash"
  ],
  "properties": {
    "cycle_id": {
      "type": "string"
    },
    "final_state": {
      "type": "string"
    },
    "converged": {
      "type": "boolean"
    },
    "rollback_performed": {
      "type": "boolean"
    },
    "execution_report": {
      "type": "object",
      "additionalProperties": true
    },
    "trace_hash": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "evidenceState": {
      "enum": [
        "REAL",
        "PROJECTED",
        "BLOCKED",
        "UNMEASURABLE"
      ]
    }
  }
}