{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/contracts/soul-mesh/mesh-combo.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comboId",
    "correlationId",
    "steps",
    "policy",
    "aggregation"
  ],
  "properties": {
    "comboId": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "input": {},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "target",
          "capability",
          "operation"
        ],
        "properties": {
          "stepId": {
            "type": "string"
          },
          "target": {
            "enum": [
              "N01",
              "N02",
              "N03",
              "N04",
              "N05",
              "N06",
              "N07",
              "SARA"
            ]
          },
          "capability": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "inputFrom": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer",
            "maximum": 30000
          },
          "required": {
            "type": "boolean"
          },
          "compensationRef": {
            "type": "string"
          }
        }
      }
    },
    "policy": {
      "enum": [
        "fail-fast",
        "best-effort",
        "compensate",
        "quorum"
      ]
    },
    "aggregation": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "ordered",
            "merge",
            "first-valid",
            "quorum"
          ]
        },
        "quorum": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "compensations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "capability"
        ],
        "properties": {
          "stepId": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          }
        }
      }
    },
    "provenancePolicy": {
      "enum": [
        "per-hop",
        "final-only",
        "both"
      ]
    }
  }
}