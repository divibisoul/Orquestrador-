{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/contracts/soul-mesh/agent-registration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nucleus",
    "role",
    "lifecycle",
    "capabilities",
    "tools",
    "resourceLimits",
    "evidenceState"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "nucleus": {
      "enum": [
        "N01",
        "N02",
        "N03",
        "N04",
        "N05",
        "N06",
        "N07",
        "SARA"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "enum": [
        "CONSTRUCTED",
        "BOUND",
        "AVAILABLE",
        "DEGRADED",
        "STOPPED"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 1
        },
        "cpuMillis": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidenceState": {
      "enum": [
        "REAL",
        "PROJECTED",
        "BLOCKED",
        "UNMEASURABLE"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}