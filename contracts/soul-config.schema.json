{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/contracts/soul-config.schema.json",
  "title": "SOUL canonical configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mesh",
    "services",
    "resilience",
    "observability",
    "data",
    "featureFlags",
    "secrets"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "mesh": {
      "type": "object",
      "required": [
        "contractVersion",
        "timeoutMs",
        "maxPayloadBytes",
        "retries",
        "breaker",
        "peerUrls"
      ],
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "1.1.0"
        },
        "timeoutMs": {
          "const": 30000
        },
        "maxPayloadBytes": {
          "const": 2097152
        },
        "retries": {
          "const": 2
        },
        "breaker": {
          "type": "object",
          "required": [
            "failureThreshold",
            "openSeconds"
          ],
          "additionalProperties": false,
          "properties": {
            "failureThreshold": {
              "const": 5
            },
            "openSeconds": {
              "const": 60
            }
          }
        },
        "peerUrls": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": true
    },
    "resilience": {
      "type": "object",
      "additionalProperties": true
    },
    "observability": {
      "type": "object",
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "featureFlags": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}